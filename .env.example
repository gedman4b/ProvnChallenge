# Copy to .env for local overrides. All vars map 1:1 to app/config.py and,
# in AWS, to SSM Parameter Store entries for the ECS task definition.

ARRIVIA_LOG_LEVEL=INFO

ARRIVIA_DOWNSTREAM_TIMEOUT_SECONDS=1.5
ARRIVIA_DOWNSTREAM_MAX_RETRIES=2
ARRIVIA_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
ARRIVIA_CIRCUIT_BREAKER_RESET_SECONDS=30

ARRIVIA_PARTNER_CONFIG_CACHE_TTL_SECONDS=300
ARRIVIA_PARTNER_CONFIG_MAX_STALENESS_SECONDS=900

ARRIVIA_FALLBACK_MAX_RECOMMENDATIONS=1
# JSON array, matches app/config.py's list[str] field
ARRIVIA_FALLBACK_EXCLUDED_CATEGORIES=["cruise","package"]

# Chaos-testing knobs — leave at 0 outside of local failure-mode testing.
# See README "Verification" for how to use these.
ARRIVIA_MOCK_MEMBER_SERVICE_FAILURE_RATE=0.0
ARRIVIA_MOCK_PARTNER_CONFIG_FAILURE_RATE=0.0
